{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "about.schema.json",
  "title": "Portfolio about content",
  "type": "object",
  "required": [
    "$schema",
    "hero",
    "summary",
    "principles",
    "history",
    "leadership",
    "problemSolving",
    "maker"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "hero": {
      "type": "object",
      "required": ["eyebrow", "heading", "description"],
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "pattern": "^\\./images/" }
      }
    },
    "summary": { "$ref": "#/definitions/narrative" },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "history": { "$ref": "#/definitions/narrative" },
    "leadership": { "$ref": "#/definitions/narrative" },
    "problemSolving": { "$ref": "#/definitions/narrative" },
    "maker": {
      "type": "object",
      "required": ["heading", "description", "gallery"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "gallery": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\./images/" }
        }
      }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "narrative": {
      "type": "object",
      "required": ["heading", "body"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
