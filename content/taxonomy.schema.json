{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "taxonomy.schema.json",
  "title": "Portfolio taxonomy",
  "type": "object",
  "required": ["$schema", "kinds", "topics"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/slug" },
      "additionalProperties": { "$ref": "#/definitions/kind" }
    },
    "topics": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/slug" },
      "additionalProperties": { "$ref": "#/definitions/topic" }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "object",
      "required": ["label", "singularLabel", "description", "color", "order"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "singularLabel": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/definitions/color" },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "topic": {
      "type": "object",
      "required": ["label", "color"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/definitions/color" }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
