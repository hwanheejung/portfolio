{
  "name": "hwanhee-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "pnpm content:compile",
    "build": "next build --webpack",
    "prebuild": "pnpm content:compile",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "article:new": "node scripts/article-new.mjs",
    "article:publish": "node scripts/article-publish.mjs",
    "article:check": "node scripts/article-check.mjs",
    "content:check": "node scripts/content-compile.mjs --check",
    "content:compile": "node scripts/content-compile.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.0.0",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-pretty-code": "^0.14.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "ajv": "6.15.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
